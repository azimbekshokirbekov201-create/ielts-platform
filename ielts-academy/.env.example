# Paths are relative to the ielts-academy directory. No Supabase keys are needed.
DATABASE_URL=file:./db/academy.db
APP_URL=http://localhost:3000
# false supports local HTTP (including npm start); set true behind HTTPS in production.
SESSION_COOKIE_SECURE=false
# Optional. AI stays disabled until an administrator enables it and the student consents.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_INPUT_USD_PER_MILLION=0.4
AI_OUTPUT_USD_PER_MILLION=1.6
